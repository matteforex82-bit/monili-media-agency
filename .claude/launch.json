{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api.server:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "studio-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:local"],
      "port": 3000
    },
    {
      "name": "vetrina-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../Ecosistema Monili/apps/web", "run", "dev", "--", "-p", "3100"],
      "port": 3100
    }
  ]
}
