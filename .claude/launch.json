{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api.server:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
