# Copia questo file in .env e inserisci le tue chiavi API

# OpenRouter (obbligatoria per testo + immagini)
OPENROUTER_API_KEY=sk-or-...

# Modello testo di default (se non selezionato dalla dashboard)
OPENROUTER_TEXT_MODEL=openai/gpt-5.5

# Modello immagini di default (se non selezionato dalla dashboard)
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# Configurazione generazione visiva
# "openrouter" | "manual"
IMAGE_GENERATOR=openrouter

# Timeout missione: il flusso completo genera anche foto sito dedicate.
MISSION_TIMEOUT_SECONDS=1800

# Modalita locale: cartella persistente sul portatile.
# Lascia vuoto su Render. In locale puoi usare, ad esempio:
# MONILI_STORAGE_DIR=C:\Users\matte\MoniliStorage
MONILI_STORAGE_DIR=

# Frontend locale: quando avvii Next dal portatile usa il backend locale.
# Su Render questa variabile resta configurata nel render.yaml.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sito vetrina (repo monili-vetrina). Lascia vuoto finché il sito non è online:
# senza indirizzo lo Studio non invia niente.
# Esempio: https://www.tuodominio.it/api/ingest/internal-webapp
SHOWCASE_INGEST_URL=
# Deve essere identico ad ADMIN_API_TOKEN della vetrina (almeno 24 caratteri).
SHOWCASE_ADMIN_TOKEN=
# Foto massime per scheda (limite 4,5 MB per richiesta su Vercel).
SHOWCASE_MAX_IMAGES=4
# Link "Apri review admin" nello Studio. Esempio: https://www.tuodominio.it/admin/review
NEXT_PUBLIC_SHOWCASE_REVIEW_URL=
