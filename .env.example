# Copia questo file in .env e inserisci le tue chiavi API

# OpenRouter (obbligatoria per testo + immagini)
OPENROUTER_API_KEY=sk-or-...

# Modello testo di default (se non selezionato dalla dashboard)
OPENROUTER_TEXT_MODEL=openai/gpt-5.5

# Modello immagini di default (se non selezionato dalla dashboard)
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2

# Configurazione generazione visiva
# "openrouter" | "manual"
IMAGE_GENERATOR=openrouter

# Timeout missione: il flusso completo genera anche foto sito dedicate.
MISSION_TIMEOUT_SECONDS=1800

# Modalita locale: cartella persistente sul portatile.
# Ad esempio:
# MONILI_STORAGE_DIR=C:\Users\matte\MoniliStorage
MONILI_STORAGE_DIR=

# Frontend locale: quando avvii Next dal portatile usa il backend locale.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sito vetrina (repo monili-vetrina). Lascia vuoto finché il sito non è online:
# senza indirizzo lo Studio non invia niente.
# Esempio: https://www.tuodominio.it/api/ingest/internal-webapp
SHOWCASE_INGEST_URL=
# Deve essere identico ad ADMIN_API_TOKEN della vetrina (almeno 24 caratteri).
SHOWCASE_ADMIN_TOKEN=
# Foto massime per scheda (limite 4,5 MB per richiesta su Vercel).
SHOWCASE_MAX_IMAGES=4
# Link "Apri review admin" nello Studio. Esempio: https://www.tuodominio.it/admin/review
NEXT_PUBLIC_SHOWCASE_REVIEW_URL=

# Foto reale ripulita per il sito (scontorno sul PC, gratis).
# Il modello (~1 GB) si scarica da solo la prima volta in <MONILI_STORAGE_DIR>/models.
# Vuoto = percorso standard. Metti 0 nel secondo per non scaricarlo mai (resta il semplice ritaglio).
CUTOUT_MODEL_PATH=
CUTOUT_MODEL_AUTO_DOWNLOAD=1

# ── REEL STUDIO (video) ─────────────────────────────────────────────
# Higgsfield API: crea Key ID + Secret su https://console.higgsfield.ai
# Senza queste chiavi Reel Studio funziona in "modalita anteprima"
# (fotogrammi animati, nessun costo video).
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Motore video di default: kling-3-std | kling-3-pro | seedance-2.5
HIGGSFIELD_VIDEO_MODEL=kling-3-std
# Budget massimo per singolo video (EUR): sopra serve conferma esplicita.
REEL_BUDGET_EUR=2.0
# Cambio usato per mostrare le stime in euro.
EUR_PER_USD=0.88

# ── OPENAI DIRETTO (GPT-Image-2.5) ──────────────────────────────────
# Facoltativa. Se presente, Reel Studio usa GPT-Image-2.5 Flare per i fotogrammi
# e Sunburst per le copertine poster (su OpenRouter il 2.5 non c'e).
# Crea la chiave su https://platform.openai.com/api-keys
OPENAI_API_KEY=
# low | medium | high | xhigh | max (alta = piu fedelta al prodotto, costa di piu)
OPENAI_IMAGE_QUALITY=high
